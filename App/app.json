{
    "expo" : {
        "name"               : "Espartan",
        "slug"               : "espartan-app",
        "version"            : "0.5.0",
        "orientation"        : "portrait",
        "icon"               : "./assets/icon.png",
        "userInterfaceStyle" : "light",
        "newArchEnabled"     : true,
        "plugins"            : [
            [
                "expo-localization",
                {
                    "supportedLocales" : {
                        "android" : [
                            "en"
                        ],
                        "ios"     : [
                            "en"
                        ]
                    }
                }
            ],
            [
                "@sentry/react-native/expo",
                {
                    "url"          : "https://sentry.io/",
                    "project"      : "espartan-app",
                    "organization" : "geekylifehacks"
                }
            ]
        ],
        "splash"             : {
            "image"           : "./assets/splash-icon.png",
            "resizeMode"      : "contain",
            "backgroundColor" : "#ffffff"
        },
        "ios"                : {
            "supportsTablet" : true,
            "infoPlist"      : {
                "CFBundleLocalizations" : [
                    "en"
                ]
            },
            "bundleIdentifier"  : "com.geekylifehacks.espartan"
        },
        "android"            : {
            "adaptiveIcon"                 : {
                "foregroundImage" : "./assets/adaptive-icon.png",
                "backgroundColor" : "#ffffff"
            },
            "edgeToEdgeEnabled"            : true,
            "predictiveBackGestureEnabled" : false,
            "package"           : "com.geekylifehacks.espartan"
        },
        "web"                : {
            "favicon" : "./assets/favicon.png"
        },
        "extra"              : {
            "eas" : {
                "projectId" : "c5c600c1-1154-4c36-b508-b88a05caf750"
            }
        }
    }
}
