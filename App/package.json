{
    "name"                : "espartan-app",
    "version"             : "0.6.15",
    "repository"          : {
        "type" : "git",
        "url"  : "https://github.com/ayltai/Espartan.git"
    },
    "bugs"                : {
        "url" : "https://github.com/ayltai/Espartan/issues"
    },
    "keywords"            : [
        "esp32",
        "smart",
        "temperature",
        "thermostat"
    ],
    "license"             : "MIT",
    "main"                : "index",
    "scripts"             : {
        "clean"          : "pnpm dlx rimraf --glob **/node_modules/* pnpm-lock.yaml",
        "reset"          : "pnpm clean && pnpm i && pnpm audit -P",
        "start"          : "expo start",
        "android"        : "expo start --android",
        "ios"            : "expo start --ios",
        "web"            : "expo start --web",
        "docker:deploy"  : "pnpm docker:prune && pnpm docker:build && pnpm docker:publish",
        "docker:build"   : "DOCKER_BUILDKIT=1 docker build --no-cache -t ayltai/geekylifehacks:espartan-app-0.6.15 .",
        "docker:publish" : "docker push ayltai/geekylifehacks:espartan-app-0.6.15",
        "docker:prune"   : "docker image remove ayltai/geekylifehacks:espartan-app-0.6.14 || true && docker system prune -f"
    },
    "dependencies"        : {
        "@expo/vector-icons"             : "^15.1.1",
        "@reduxjs/toolkit"               : "^2.11.2",
        "@sentry/react-native"           : "^8.11.0",
        "@shopify/react-native-skia"     : "^2.6.2",
        "canvaskit-wasm"                 : "^0.41.1",
        "date-fns"                       : "^4.1.0",
        "expo"                           : "^55.0.23",
        "expo-linear-gradient"           : "^55.0.13",
        "expo-localization"              : "^55.0.13",
        "react"                          : "^19.2.6",
        "react-native"                   : "~0.83.9",
        "react-native-circular-progress" : "^1.4.1",
        "react-native-gesture-handler"   : "^2.31.2",
        "react-native-paper"             : "^5.15.2",
        "react-native-reanimated"        : "~4.2.3",
        "react-native-safe-area-context" : "~5.7.0",
        "react-native-screens"           : "^4.25.0",
        "react-native-svg"               : "^15.15.4",
        "react-native-worklets"          : "~0.7.4",
        "react-redux"                    : "^9.2.0",
        "victory-native"                 : "^41.20.2"
    },
    "devDependencies"     : {
        "@react-native/metro-config"    : "^0.85.3",
        "@testing-library/react-native" : "^13.3.3",
        "@types/react"                  : "^19.2.14",
        "react-dom"                     : "^19.2.6",
        "react-native-web"              : "^0.21.2",
        "typescript"                    : "^6.0.3"
    },
    "trustedDependencies" : [
        "@shopify/react-native-skia"
    ],
    "resolutions"         : {
        "@xmldom/xmldom" : "^0.8.13",
        "postcss"        : "^8.5.10",
        "uuid"           : "^14.0.0"
    },
    "jest"                : {
        "collectCoverage" : true,
        "preset"          : "jest-expo"
    },
    "engines"             : {
        "node" : ">=22",
        "pnpm" : ">=10"
    }
}
